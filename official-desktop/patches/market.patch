+  /** Install one server-approved artifact under the official package lock and lifecycle. */
+  async installApproved(plugin: ApprovedPlugin, bytes: Buffer, hooks: DesktopProjectHooks): Promise<void> {
+    await this.withLock(async () => {
+      this.currentRuntime()
+      approvedCatalog({ market_id: 'dsh-ipzsk-market', plugins: [plugin] })
+      const installed = Object.hasOwn(projectManifest(this.paths.profile).dependencies, plugin.package_name)
+        ? inspectPlugin(this.paths.profile, plugin.package_name).version : undefined
+      assertPluginUpgrade(installed, plugin.version)
+      await this.installVerifiedArchive(plugin, bytes, hooks)
+    })
+  }
+
+  /** First-install-only preview bootstrap; never replaces an existing dependency. No IPC exposes this method. */
+  async installBundledPreview(value: BundledPreviewPlugin, bytes: Buffer, hooks: DesktopProjectHooks): Promise<boolean> {
+    return this.withLock(async () => {
+      this.currentRuntime()
+      const plugin = parseBundledPreviewPlugin(value)
+      if (Object.hasOwn(projectManifest(this.paths.profile).dependencies, plugin.packageName)) return false
+      await this.installVerifiedArchive({ package_name: plugin.packageName, version: plugin.version,
+        sha256: plugin.sha256, size_bytes: plugin.sizeBytes }, bytes, hooks)
+      return true
+    })
+  }
+
+  /** Both callers hold the official package lock; failures retain pending state for startup recovery. */
+  private async installVerifiedArchive(plugin: PluginArchiveIdentity, bytes: Buffer, hooks: DesktopProjectHooks): Promise<void> {
+    verifyArchive(bytes, plugin, IPZSK_DESKTOP_API_VERSION)
+    if (this.currentRuntime().sharedPackages.some(entry => entry.name === plugin.package_name)) {
+      throw new Error(`desktop project: cannot install host-owned package ${plugin.package_name}`)
+    }
+    // Validate existing metadata before stopping a healthy Host.
+    projectManifest(this.paths.profile)
+    const directory = join(this.paths.profile, '.ipzsk-packages')
+    mkdirSync(directory, { recursive: true, mode: 0o700 })
+    if (lstatSync(directory).isSymbolicLink()) throw new Error('desktop project: archive directory must not be a link')
+    const archive = join(directory, `${plugin.sha256}.tgz`)
+    if (existsSync(archive)) {
+      if (!lstatSync(archive).isFile() || lstatSync(archive).isSymbolicLink()) throw new Error('desktop project: invalid reviewed archive file')
+      verifyArchive(readFileSync(archive), plugin, IPZSK_DESKTOP_API_VERSION)
+    } else {
+      writeFileSync(archive, bytes, { mode: 0o600, flag: 'wx' })
+    }
+    await hooks.beforeChange()
+    const previous = readDesktopProfileState(this.paths.profile)
+    unlinkDesktopHostPackages(this.paths.profile)
+    try {
+      await this.runPnpm(this.paths.profile, ['add', `./.ipzsk-packages/${plugin.sha256}.tgz`, '--save-exact', '--ignore-scripts'])
+      const installed = { ...inspectPlugin(this.paths.profile, plugin.package_name), enabled: true }
+      if (installed.version !== plugin.version) throw new Error('desktop project: installed reviewed version does not match')
+      const spec = projectManifest(this.paths.profile).dependencies[plugin.package_name]
+      if (spec !== `file:.ipzsk-packages/${plugin.sha256}.tgz`) throw new Error('desktop project: reviewed archive dependency does not match')
+      writeProfilePlugins(this.paths.profile, [...pluginRecords(this.paths.profile).filter(item => item.name !== installed.name), installed]
+        .sort((left, right) => left.name.localeCompare(right.name)))
+    } finally {
+      linkDesktopHostPackages(this.paths.profile, this.runtime.dsh, this.currentRuntime())
+    }
