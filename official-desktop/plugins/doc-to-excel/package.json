{
  "name": "dsh-doc-to-excel",
  "version": "0.3.0-beta.1",
  "description": "IPZSK 文档转 Excel：官方 Connection Fetch、Word/PDF 本地解析、大 PDF 断点续跑",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    },
    "desktop": {
      "transport": "connection",
      "minVersion": "0.1.5-rc.2"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-rc.2 || >=3.0.0-beta.1"
  },
  "files": [
    "lib",
    "src",
    "scripts/*.py",
    "scripts/*.swift",
    "scripts/build.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "release:pack": "node scripts/release.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JayceHuang/dsh-doc-to-excel.git"
  },
  "homepage": "https://github.com/JayceHuang/dsh-doc-to-excel#readme",
  "bugs": {
    "url": "https://github.com/JayceHuang/dsh-doc-to-excel/issues"
  }
}
