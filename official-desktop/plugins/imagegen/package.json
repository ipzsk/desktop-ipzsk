{
  "name": "@dickpy/dsh-imagegen",
  "description": "AI image generation plugin for the dsh web GUI: text-to-image and image-to-image through configurable provider channels (gpt-image-2 / grok-imagine-image / nanobanana series / seedream-5.0-pro / dall-e-3, with native xAI Grok Imagine, Google Nano Banana and ByteDance Seedream request shaping), with per-channel model catalogs and a New Session / Image Generation tab entry opening a three-column studio beside the native conversation.",
  "version": "1.8.0-beta.1",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-store"
      ]
    },
    "desktop": {
      "transport": "connection",
      "minVersion": "0.1.5-rc.2"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": "3.0.0-beta.1",
    "@deepseek-ai/dsh-api-session-controller": "3.0.0-beta.1",
    "@deepseek-ai/dsh-attachment": "3.0.0-beta.1",
    "@deepseek-ai/dsh-client-connection": "3.0.0-beta.1",
    "@deepseek-ai/dsh-client-locale": "3.0.0-beta.1",
    "@deepseek-ai/dsh-client-store": "3.0.0-beta.1",
    "@deepseek-ai/dsh-client-ui-conversation": "3.0.0-beta.1",
    "@deepseek-ai/dsh-client-ui-primitives": "3.0.0-beta.1",
    "@deepseek-ai/dsh-client-ui-renderer": "3.0.0-beta.1",
    "@deepseek-ai/dsh-client-ui-settings": "3.0.0-beta.1",
    "@deepseek-ai/dsh-client-ui-slots": "3.0.0-beta.1",
    "@deepseek-ai/dsh-commands": "3.0.0-beta.1",
    "@deepseek-ai/dsh-llm": "3.0.0-beta.1",
    "@deepseek-ai/dsh-settings": "3.0.0-beta.1",
    "@deepseek-ai/dsh-system-prompt": "3.0.0-beta.1",
    "@deepseek-ai/dsh-tools": "3.0.0-beta.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "jsdom": "25.0.1",
    "lightningcss": "1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "3.0.0-beta.1",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "docs",
    "README.md"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayceHuang/dsh-imagegen.git"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "fetch-templates": "node scripts/fetch-templates.mjs",
    "test": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-attachment": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-client-store": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-commands": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 || >=3.0.0-beta.1",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
